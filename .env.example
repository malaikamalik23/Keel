# Set ONE of these (not needed to run the tests).
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Which provider to use. "auto" (default) picks Anthropic if ANTHROPIC_API_KEY is set,
# else Groq if GROQ_API_KEY is set. Set explicitly if you ever have both keys defined.
LLM_PROVIDER=auto

# Model used by the agent. Must match whichever provider is active above.
#   Anthropic: claude-sonnet-5, claude-opus-5-5, claude-haiku-4-5-20251001, ...
#   Groq:      llama-3.3-70b-versatile, openai/gpt-oss-120b, moonshotai/kimi-k2-instruct, ...
#   (Not every Groq model supports tool calling well — llama-3.3-70b-versatile and the
#   openai/gpt-oss models are solid choices for this agent, which relies on tools heavily.)
AGENT_MODEL=claude-sonnet-5

# Your IANA timezone, e.g. Europe/London, America/New_York. Used for "today".
AGENT_TIMEZONE=UTC

DATABASE_URL=sqlite:///./data/agent.db

# Safety: set true to require confirmation for WRITE tools too (default: only HIGH_IMPACT)
CONFIRM_WRITES=false

# If set, every /api/* request must send this exact value as the X-API-Key header (except /health).
# Unset by default -- fine for localhost-only use, but set this before exposing the API to a network.
# API_KEY=change-me-to-something-random

# Hours a pending high-impact action stays approvable before it auto-expires. Set to 0 (or blank) to
# disable expiry and let pending actions live forever, as in earlier versions.
PENDING_ACTION_TTL_HOURS=24

# When a conversation grows past HISTORY_MESSAGE_LIMIT, fold the messages that fall out of the replayed
# window into a running summary instead of silently dropping them. Set false to restore the old
# truncate-only behavior.
SUMMARIZE_DROPPED_HISTORY=true
