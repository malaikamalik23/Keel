# Copy to .env and edit. Never commit .env (it is in .gitignore).
# Everything is optional except ONE LLM key. Values shown are the defaults unless marked "example".

# ---------------------------------------------------------------- LLM (set ONE key)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# auto = Anthropic if its key is set, else Groq. Set explicitly if you define both.
# ollama = a model on this computer (no key; chats never leave it). Never chosen by auto. See docs/INSTALL.md.
LLM_PROVIDER=auto
# Used only with LLM_PROVIDER=ollama. The model must support tools (`ollama show <model>` lists them under Capabilities).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window. Keel's prompt plus tools need ~6-9k tokens; Ollama's own default is smaller and would cut the prompt.
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=300
# Must match the provider. Anthropic: claude-sonnet-5. Groq (the model must support tool calling): openai/gpt-oss-120b works on
# the free tier; llama-3.3-70b-versatile is listed as Enterprise-only on Groq's models page (checked Nov 2026), so it may 404 for you.
AGENT_MODEL=claude-sonnet-5
# lean (default): each request carries only the core tools plus the groups the message needs, ~3k tokens of overhead instead of ~7k.
# Needed on Groq's free tier (8,000 tokens/minute); also cheaper everywhere. full: every tool in every request.
TOOL_PROFILE=lean
# Your IANA timezone. "Today", check-in times and quiet hours all use it.
AGENT_TIMEZONE=UTC
DATABASE_URL=sqlite:///./data/agent.db

# Agent loop limits.
# Max LLM calls per user message (stops runaway tool loops), messages replayed to the model per turn, and reply length cap.
MAX_AGENT_STEPS=8
# (On Groq's free tier use ~10-12: history is resent with every request and counts against the 8,000 tokens/minute.)
HISTORY_MESSAGE_LIMIT=40
MAX_OUTPUT_TOKENS=1500
# Randomness when the model picks a tool (0-1). Low keeps the same message routed the same way run after run.
# Leave empty to use the provider's default (usually about 1).
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------- Safety
# Require approval for WRITE tools too (HIGH_IMPACT ones like delete_* always need it).
CONFIRM_WRITES=false
# REQUIRED before exposing the API beyond localhost (and enforced by docker-compose). Sent as the X-API-Key header.
# API_KEY=generate-a-long-random-string
# Hours an unanswered approval request stays valid. 0 = never expires.
PENDING_ACTION_TTL_HOURS=24
# Max requests per minute per client to endpoints that call the LLM (/api/chat, /api/scheduler/tick). 0 = off.
RATE_LIMIT_PER_MINUTE=30
# Fold messages that age out of the context window into a running summary (costs one extra LLM call when it happens).
SUMMARIZE_DROPPED_HISTORY=true

# ---------------------------------------------------------------- Scheduler, check-ins, notifications
# Starts the in-process scheduler with the API. Run ONE process only (or use `python -m app.scheduler` instead).
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=60
MORNING_CHECKIN_TIME=08:00
EVENING_CHECKIN_TIME=20:00
# 0=Monday ... 6=Sunday. The weekly review replaces that evening's check-in.
WEEKLY_CHECKIN_WEEKDAY=6
# A check-in more than this many hours late is skipped rather than sent stale.
CHECKIN_GRACE_HOURS=3.0
# Notification budget: at most this many messages per day, excluding reminders you asked for.
NOTIFICATION_MAX_PER_DAY=5
# Slots held back from nudges so the morning/evening check-ins always fit.
CHECKIN_RESERVE=2
# low | normal | high: nudges below this are not sent.
NOTIFICATION_MIN_PRIORITY=normal
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
# Working hours the planner fits today's tasks into, around your calendar events (local time).
WORKDAY_START=09:00
WORKDAY_END=21:00
# Telegram delivery (+ chat from your phone). Create a bot with @BotFather; get your numeric chat id from @userinfobot.
# The bot only ever talks to / listens to this one chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INBOUND=true
# Email delivery, if you don't use Telegram. Reminders and check-ins are emailed to EMAIL_TO (your own address).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com and an App Password (Google Account >
# Security > 2-Step Verification > App passwords), not your normal password. Outlook: smtp-mail.outlook.com, 587.
# SMTP_SECURITY: starttls (port 587) or ssl (port 465). Unencrypted SMTP is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Read-only calendar: the SECRET iCal address (Google Calendar: Settings > your calendar > "Secret address in iCal format").
CALENDAR_ICS_URL=

# ---------------------------------------------------------------- Research tools
WEB_FETCH_ENABLED=true
# Comma-separated. If WEB_ALLOWED_DOMAINS is set, web_fetch reaches ONLY these domains (and their subdomains).
# example: WEB_ALLOWED_DOMAINS=arxiv.org,github.com,wikipedia.org
WEB_ALLOWED_DOMAINS=
WEB_BLOCKED_DOMAINS=
# Enables web_search (Brave Search API key: https://brave.com/search/api/).
BRAVE_API_KEY=
# Folder of notes/papers (.md .txt .rst .tex .org .pdf) indexed for notes_search. Re-scanned at startup, and by /index.
NOTES_DIR=
GITHUB_ENABLED=true
# Optional. Only needed for private repos or higher rate limits. A fine-grained, read-only token is enough.
GITHUB_TOKEN=
# Default account for "list my repos".
GITHUB_USER=

# ---------------------------------------------------------------- Gmail (optional)
# Your own Google OAuth client, type "Desktop app" (docs/INSTALL.md, "Connect Gmail"). Then run once:
#   python -m scripts.gmail_connect
# Keel can read, search and draft; sending needs your approval of each email. It can't delete mail or change labels.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Where the saved sign-in goes. Keep it private; data/ is never committed.
GMAIL_TOKEN_PATH=data/gmail_token.json
# false = read and draft only, never send.
GMAIL_SEND_ENABLED=true
GMAIL_MAX_SENDS_PER_DAY=20

# ---------------------------------------------------------------- Dashboard
# Built dashboard served at /. Blank disables it.
FRONTEND_DIST=frontend/dist
